# Postgres connection string. For local dev without a Postgres server,
# point this at a SQLite file instead and switch the provider in
# prisma/schema.prisma to "sqlite" (see README).
DATABASE_URL="postgresql://user:password@localhost:5432/quloi_ai_orchestration"

# Anthropic API key used by core/llm/client.ts. Required to actually generate
# BRDs / action items; without it the app still runs but generation calls
# will fail with a clear error rather than fabricating output.
ANTHROPIC_API_KEY="sk-ant-..."

# FR-1: only needed to import a transcript from a Google Doc link (pasting
# raw transcript text still works with no configuration at all). Create a
# Google Cloud service account, enable the Google Docs API for its project,
# then paste the full contents of its downloaded JSON key file here as a
# single-line string. Each transcript Doc you want to import must then be
# shared with that key's `client_email` as a Viewer -- there's no per-user
# OAuth flow in this app (see README).
GOOGLE_SERVICE_ACCOUNT_KEY='{"client_email":"...","private_key":"..."}'
