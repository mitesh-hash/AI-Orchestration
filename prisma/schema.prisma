// Data model built up slice by slice, matching the entities in FRD Section 8
// as each slice needs them. Comparison / DecisionLogEntry are still
// deferred (FR-12/13) rather than stubbed out ahead of time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  BRD
  FRD
  PRD
}

// draft: just generated, not yet shown for review
// pending_approval: shown to a reviewer, awaiting a decision
// approved / rejected: terminal states set only via the approval guardrail
enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Transcript {
  id        String   @id @default(cuid())
  source    String // 'paste' | 'upload' | 'google_doc' (google_doc deferred)
  title     String?
  meetingDate DateTime
  rawText   String
  createdAt DateTime @default(now())

  documents    RequirementDocument[]
  actionItems  ActionItem[]
  devSpecNotes DevSpecNote[]
}

model RequirementDocument {
  id         String         @id @default(cuid())
  type       DocumentType
  version    Int            @default(1)
  // Structured content: { title, sections: [{ heading, text, sourceRefs }] }
  content    Json
  // Sections/points the source material didn't cover, per FR-5.
  gaps       Json
  status     DocumentStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  transcripts Transcript[]
  tickets     Ticket[]
}

enum TicketType {
  PRODUCT_DISCOVERY
  DEVELOPMENT
}

model Ticket {
  id          String         @id @default(cuid())
  type        TicketType
  // Only meaningful for PRODUCT_DISCOVERY tickets ("User Journey" | "Design"
  // | "FRD", enforced by the Zod schema at generation time, FR-7). Left as a
  // free string rather than a Prisma enum because DEVELOPMENT tickets don't
  // use this taxonomy.
  milestone   String?
  title       String
  description String
  // Citations back into whichever source this ticket was drafted from --
  // the BRD's content for PRODUCT_DISCOVERY (FR-7), the pasted spec/design
  // text for DEVELOPMENT (FR-8). Same traceability principle as FR-2, one
  // level up the chain either way.
  sourceRefs  Json
  status      DocumentStatus @default(DRAFT)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())

  // Exactly one of these two is set, enforced at the application layer
  // (core/db/ticketRepository.ts) rather than a DB constraint: every write
  // path is one of the two typed create functions there, neither of which
  // can set both.
  sourceDocumentId String?
  sourceDocument    RequirementDocument? @relation(fields: [sourceDocumentId], references: [id])

  sourceDevSpecId String?
  sourceDevSpec   DevSpecNote? @relation(fields: [sourceDevSpecId], references: [id])
}

// FR-8's "signed-off design and developer specs" input, until FR-11
// (wireframes) and FR-16 (developer spec generation) exist to produce this
// automatically -- a BA pastes it as free text, same pattern as Transcript
// for FR-1. Scoped to a transcript so it shows up alongside that feature's
// BRD and tickets on the review page.
model DevSpecNote {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  title        String?
  rawText      String
  createdAt    DateTime   @default(now())

  tickets Ticket[]
}

model ActionItem {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  description  String
  // Always populated by the app layer with either the stated name or the
  // literal "Owner not specified" (FR-6) -- never left blank or guessed.
  owner        String
  // Stored as the transcript's own words ("next Friday", "end of Q3"), not
  // coerced into a Date -- doing so could silently fabricate a specific
  // date the transcript never actually stated.
  deadline     String?
  status       String     @default("open")
  createdAt    DateTime   @default(now())
}
