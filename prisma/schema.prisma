// Data model built up slice by slice, matching the entities in FRD Section 8
// as each slice needs them. DecisionLogEntry is still deferred rather than
// stubbed out ahead of time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  BRD
  FRD
  PRD
}

// draft: just generated, not yet shown for review
// pending_approval: shown to a reviewer, awaiting a decision
// approved / rejected: terminal states set only via the approval guardrail
enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Transcript {
  id        String   @id @default(cuid())
  source    String // 'paste' | 'upload' | 'google_doc' (google_doc deferred)
  title     String?
  meetingDate DateTime
  rawText   String
  createdAt DateTime @default(now())

  documents            RequirementDocument[]
  actionItems          ActionItem[]
  devSpecNotes         DevSpecNote[]
  designSystemNotes    DesignSystemNote[]
  comparisons          Comparison[]
  prototypeExtractions PrototypeExtraction[]
}

model RequirementDocument {
  id         String         @id @default(cuid())
  type       DocumentType
  version    Int            @default(1)
  // Structured content: { title, sections: [{ heading, text, sourceRefs }] }
  content    Json
  // Sections/points the source material didn't cover, per FR-5.
  gaps       Json
  status     DocumentStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  transcripts          Transcript[]
  tickets              Ticket[]
  diagrams             Diagram[]
  wireframeSets        WireframeSet[]
  prototypeCrossChecks PrototypeCrossCheck[]
  devSpecs             DevSpec[]
}

enum TicketType {
  PRODUCT_DISCOVERY
  DEVELOPMENT
}

model Ticket {
  id          String         @id @default(cuid())
  type        TicketType
  // Only meaningful for PRODUCT_DISCOVERY tickets ("User Journey" | "Design"
  // | "FRD", enforced by the Zod schema at generation time, FR-7). Left as a
  // free string rather than a Prisma enum because DEVELOPMENT tickets don't
  // use this taxonomy.
  milestone   String?
  title       String
  description String
  // Citations back into whichever source this ticket was drafted from --
  // the BRD's content for PRODUCT_DISCOVERY (FR-7), the pasted spec/design
  // text for DEVELOPMENT (FR-8). Same traceability principle as FR-2, one
  // level up the chain either way.
  sourceRefs  Json
  status      DocumentStatus @default(DRAFT)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())

  // Exactly one of these two is set, enforced at the application layer
  // (core/db/ticketRepository.ts) rather than a DB constraint: every write
  // path is one of the two typed create functions there, neither of which
  // can set both.
  sourceDocumentId String?
  sourceDocument    RequirementDocument? @relation(fields: [sourceDocumentId], references: [id])

  sourceDevSpecId String?
  sourceDevSpec   DevSpecNote? @relation(fields: [sourceDevSpecId], references: [id])
}

// FR-8's "signed-off design and developer specs" input, until FR-11
// (wireframes) and FR-16 (developer spec generation) exist to produce this
// automatically -- a BA pastes it as free text, same pattern as Transcript
// for FR-1. Scoped to a transcript so it shows up alongside that feature's
// BRD and tickets on the review page.
model DevSpecNote {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  title        String?
  rawText      String
  createdAt    DateTime   @default(now())

  tickets Ticket[]
}

enum DiagramType {
  USER_FLOW
}

// FR-10: derived from an existing BRD's content, same source pattern as
// FR-7's Product Discovery tickets (not a fresh paste -- the BRD already
// describes the process). content is a validated graph: { title, nodes:
// [{id,label,type,sourceRefs}], edges: [{from,to,label?}] }, rendered to
// Mermaid syntax deterministically at display time (core/diagramming/
// renderMermaid.ts) rather than trusting the LLM to emit Mermaid text
// directly -- keeps the citation contract schema-enforceable per node.
model Diagram {
  id         String         @id @default(cuid())
  type       DiagramType
  content    Json
  gaps       Json
  status     DocumentStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  sourceDocumentId String
  sourceDocument   RequirementDocument @relation(fields: [sourceDocumentId], references: [id])
}

// FR-11's "existing design system" reference, until a real design-system /
// Figma integration exists -- pasted as free text, same pattern as
// DevSpecNote for FR-8. Scoped per-transcript for now; a follow-up slice
// could make this reusable across transcripts instead of re-pasted each
// time (see README).
model DesignSystemNote {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  title        String?
  rawText      String
  createdAt    DateTime   @default(now())

  wireframeSets WireframeSet[]
}

// FR-11: 2-3 rough wireframe options, grounded in both the BRD (why a
// region exists) and a DesignSystemNote (how it should look). content is
// { options: [{ name, regions: [{label,kind,sourceRefs}] }] }. The whole
// set is approved/rejected together rather than option-by-option -- a
// reviewer picks the set they're happy with as one decision, per FR-18.
model WireframeSet {
  id         String         @id @default(cuid())
  content    Json
  gaps       Json
  status     DocumentStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  sourceDocumentId String
  sourceDocument   RequirementDocument @relation(fields: [sourceDocumentId], references: [id])

  designSystemNoteId String
  designSystemNote   DesignSystemNote @relation(fields: [designSystemNoteId], references: [id])
}

// FR-12/13: compares two freely pasted text blocks (confirmed with the
// user rather than tied to a specific entity type -- either side can be a
// generated artifact's text pasted in, fresh feedback, anything). textA/
// textB are always saved immediately so nothing pasted is lost if
// generation fails; content stays null until it succeeds (same principle
// as Transcript vs RequirementDocument in slice 1).
model Comparison {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  labelA       String?
  textA        String
  labelB       String?
  textB        String
  // { rows: [{ topic, aSummary, bSummary, isConflict, sourceRefs }] }
  content    Json?
  status     DocumentStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())
}

// FR-14's "frozen/signed-off HTML prototype" input -- pasted as raw HTML
// text (confirmed with the user; no file upload infrastructure exists).
// rawHtml is always saved immediately, same always-preserved-input
// principle as Comparison above.
model PrototypeExtraction {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  title        String?
  rawHtml      String
  // { title, sections: [{ name, elements: [{kind,label,details?,sourceRefs}] }] }
  content    Json?
  status     DocumentStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  crossChecks PrototypeCrossCheck[]
  devSpecs    DevSpec[]
}

// FR-15: cross-checks a BRD against an already-extracted prototype
// structure. Only created once generation succeeds (both its inputs --
// the BRD and the PrototypeExtraction -- already persist independently of
// this record, so there's nothing of the user's to lose on failure, unlike
// Comparison/PrototypeExtraction above). Scoped explicitly to static
// structure/content, never claiming to verify runtime behavior -- see the
// prompt in core/llm/prompts.ts and the review page's disclaimer.
model PrototypeCrossCheck {
  id   String @id @default(cuid())
  // { mismatches: [{topic,documented,prototypeShows,sourceRefs}], notCheckable: [{section,reason}] }
  content    Json
  status     DocumentStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  sourceDocumentId String
  sourceDocument   RequirementDocument @relation(fields: [sourceDocumentId], references: [id])

  prototypeExtractionId String
  prototypeExtraction   PrototypeExtraction @relation(fields: [prototypeExtractionId], references: [id])
}

// FR-16/17: validations, business rules, and error/success messages,
// generated from the BRD (the "feature description" FR-16 names) and an
// already-extracted prototype structure (FR-14, the "frozen prototype").
// Same shape as PrototypeCrossCheck: only created once generation
// succeeds, since both inputs already persist independently -- nothing of
// the user's to lose on a failed attempt. FR-17's "needs confirmation"
// flag lives per-rule inside content, not as a separate list: a rule
// either cites something the BRD/prototype explicitly states, or it's
// marked needsConfirmation and must never render as settled.
model DevSpec {
  id   String @id @default(cuid())
  // { rules: [{type,description,needsConfirmation,sourceRefs}], gaps: [{section,reason}] }
  content    Json
  status     DocumentStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  sourceDocumentId String
  sourceDocument   RequirementDocument @relation(fields: [sourceDocumentId], references: [id])

  prototypeExtractionId String
  prototypeExtraction   PrototypeExtraction @relation(fields: [prototypeExtractionId], references: [id])
}

model ActionItem {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  description  String
  // Always populated by the app layer with either the stated name or the
  // literal "Owner not specified" (FR-6) -- never left blank or guessed.
  owner        String
  // Stored as the transcript's own words ("next Friday", "end of Q3"), not
  // coerced into a Date -- doing so could silently fabricate a specific
  // date the transcript never actually stated.
  deadline     String?
  status       String     @default("open")
  createdAt    DateTime   @default(now())
}
